            "position": {
              "x": 2,
              "y": 10
            },
            "when": {
              "path": [
                "variables",
                "sealBroken"
              ],
              "equals": true
            },
            "lockedText": "The glass seal holds. Its keeper must fall first."
          }
        ],
        "choices": [
          {
            "id": "workshop-note",
            "label": "Read the foreman’s note",
            "text": "The guardian cannot be outrun in close quarters. The old Spark technique reaches across the room.",
            "once": true
          }
        ]
      },
      "heart-vault": {
        "id": "heart-vault",
        "name": "III · The Heart Vault",
        "description": "A single ember hangs in the chamber, bright as a remembered sunrise. The sentinel unfolds from its throne. This is what it has been waiting for.",
        "entry": {
          "x": 2,
          "y": 10
        },
        "map": [
          "#################",
          "#...............#",
          "#...............#",
