    "scenes": {
      "cinder-gate": {
        "id": "cinder-gate",
        "name": "I · The Cinder Gate",
        "description": "A dead furnace breathes beneath the mountain. Recover its living ember before the last light above goes out. Move with WASD or the arrow keys. Click a nearby foe to strike; use Spark at a distance.",
        "entry": {
          "x": 2,
          "y": 10
        },
        "map": [
          "#################",
          "#...............#",
          "#......#........#",
          "#......#..^^....#",
          "#...............#",
          "#......#........#",
          "#......#..#####.#",
          "#......#........#",
          "#...............#",
          "#......#........#",
          "#...............#",
          "#...............#",
          "#################"
        ],
        "background": "tiles",
        "ambient": "A low, copper-colored hum.",
        "objective": "Reach the eastern stair. Find supplies before descending.",
        "exits": [
          {
            "x": 14,
            "y": 2,
            "scene": "glassworks",
            "position": {
              "x": 2,
              "y": 10
            }
          }
        ],
        "tiles": {
          "~": {
            "name": "Cold water"
          },
          "^": {
            "name": "Hot cinder",
            "color": "#e68a35",
            "effects": [
              {
                "type": "damage",
                "target": "player",
                "amount": 2
              },
              {
                "type": "narrate",
                "text": "Hot cinders bite through your boots."
              }
            ]
          }
        },
        "choices": [
          {
            "id": "read-gate",
            "label": "Read the scratched warning",
            "text": "“It eats what you give it. Give it neither fear nor fire.”",
            "once": true
          }
        ]
      },
      "glassworks": {
        "id": "glassworks",
        "name": "II · The Glassworks",
        "description": "The old workshops are frozen mid-task. Behind cracked glass, a bell still rings on its own. A rune on the northern door answers to the glasskeeper.",
        "entry": {
          "x": 2,
          "y": 10
        },
        "map": [
          "#################",
          "#...............#",
          "#....#..........#",
          "#....#~~~~.#....#",
          "#....#.....#....#",
          "#..........#....#",
          "#....#.....#....#",
          "#....#..........#",
          "#..........#....#",
          "#....#.....#....#",
          "#..........#....#",
          "#...............#",
          "#################"
        ],
        "background": "tiles",
        "objective": "Defeat the Glasskeeper to break the northern seal.",
        "exits": [
          {
            "x": 2,
            "y": 11,
            "scene": "cinder-gate",
            "position": {
              "x": 14,
              "y": 3
            }
          },
