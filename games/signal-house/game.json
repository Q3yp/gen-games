      },
      "maraved-letter": {
        "id": "maraved-letter",
        "name": "Mara’s letter",
        "kind": "item",
        "components": {
          "appearance": {
            "glyph": "✉",
            "color": "#e4cda7"
          },
          "item": {
            "consumable": false,
            "description": "A letter asking you to find June and keep a promise.",
            "effects": [
              {
                "type": "narrate",
                "text": "“If you hear my voice on the midnight band, don’t answer alone. Find June. Tell her I kept the promise.”"
              },
              {
                "type": "set",
                "path": [
                  "variables",
                  "readLetter"
                ],
                "value": true
              }
            ]
          }
