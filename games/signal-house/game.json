            "color": "#d29a69"
          },
          "interact": {
            "text": "The copper seam can be carefully soldered. Examine the workshop choices."
          },
          "position": {
            "x": 4,
            "y": 7,
            "scene": "workshop"
          }
        }
      },
      "ledger": {
        "id": "ledger",
