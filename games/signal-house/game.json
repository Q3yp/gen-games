      },
      "june": {
        "id": "june",
        "name": "June",
        "kind": "character",
        "components": {
          "appearance": {
            "glyph": "J",
            "color": "#d7ab69"
          },
          "interact": {
            "text": "“The workshop has the coil. The archive has the truth. I’ll be here when you’re ready.”",
            "effects": [
              {
                "type": "set",
                "path": [
                  "variables",
                  "knowPlan"
                ],
                "value": true
              }
            ]
          },
          "position": {
            "x": 4,
            "y": 7,
            "scene": "foyer"
          }
        }
      },
      "workbench": {
        "id": "workbench",
